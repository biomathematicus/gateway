# Secrets and local configuration: never published
programs/env/secrets.env
programs/env/config.toml
*.env

# Student-level caches and raw data: never tracked
**/data/pkl/
**/data/
*.pkl
/data/

# Python and editor residue
__pycache__/
*.pyc
.vscode/
.idea/

# Working files of the one-time conversion of the manuscript's numbers
programs/macros/_work/

# Results of the first run on eleven cohorts (entrants before Fall 2014)
prespecification/results_report.md

# Outputs. Nothing under programs/figures is tracked by pattern. The
# released outputs are the files listed in programs/figures/RELEASE.txt,
# written by programs/tools/release_files.py: the files the macro modules
# read and the files the manuscript includes. Each is an aggregate, and the
# list is checked by programs/tools/disclosure_scan.py before a commit.
#     python programs/tools/release_files.py --stage
programs/figures/**
!programs/figures/
!programs/figures/RELEASE.txt
!programs/figures/RELEASE_MANIFEST.csv
